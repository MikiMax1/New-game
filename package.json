{
  "name": "solmar",
  "private": true,
  "version": "0.1.0",
  "description": "Project SOLMAR: an original open-world game set in the fictional city of Port Solmar",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "shoot": "node tools/shoot.mjs",
    "assets": "node tools/assets/fetch.mjs",
    "capture-screenshot": "node tools/shoot.mjs showcase.html docs/screens/showcase/street.png --size 1600x900 --timeout 900"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "earcut": "^3.2.3",
    "n8ao": "^2.0.1",
    "postprocessing": "~6.39.5",
    "simplex-noise": "^4.0.3",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@types/clipper-lib": "^6.4.0",
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.20.4",
    "@types/three": "~0.186.0",
    "playwright": "1.56.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
