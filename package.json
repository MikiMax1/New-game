    "simplex-noise": "^4.0.3",
    "three": "~0.186.1"
  },
  "devDependencies": {
    "@types/earcut": "^3.0.0",
    "@types/node": "^22.20.4",
    "@types/three": "~0.186.0",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.1"
  }
}
